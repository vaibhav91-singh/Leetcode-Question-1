class Solution {
    public String longestPalindrome(String s) {
        if (s == null || s.length() < 1) return "";
        
        int start = 0;
        int end = 0;
        
        for (int i = 0; i < s.length(); i++) {
            // Case 1: Odd length palindrome (e.g., "aba", center is s.charAt(i))
            int len1 = expandAroundCenter(s, i, i);
            
            // Case 2: Even length palindrome (e.g., "abba", center is between i and i+1)
            int len2 = expandAroundCenter(s, i, i + 1);
            
            // Find the maximum length between the two cases
            int len = Math.max(len1, len2);
            
            // If we found a longer palindrome, update the start and end boundaries
            if (len > end - start) {
                start = i - (len - 1) / 2;
                end = i + len / 2;
            }
        }
        
        // substring in Java is exclusive of the end index, so we use end + 1
        return s.substring(start, end + 1);
    }
    
    private int expandAroundCenter(String s, int left, int right) {
        // Expand outwards as long as boundaries are valid and characters match
        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {
            left--;
            right++;
        }
        // Return the length of the palindrome found
        // (right - left - 1) because the while loop terminates *after* moving out of bounds
        return right - left - 1;
    }
}
