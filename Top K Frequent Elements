import java.util.*;
class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        Hashtable<Integer,Integer> countTable = new Hashtable<>();
        for (int num : nums) {
            countTable.put(num, countTable.getOrDefault(num, 0) + 1);
        }
        PriorityQueue<Integer> minHeap = new PriorityQueue<>(
            (a, b) -> countTable.get(a) - countTable.get(b)
        );
       for (int num : countTable.keySet()) {
            minHeap.add(num);
            if (minHeap.size() > k) {
                minHeap.poll();
            }
        }
        int[] result = new int[k];
        for (int i = k - 1; i >= 0; i--) {
            result[i] = minHeap.poll();
        }
        return  result;
}
}
