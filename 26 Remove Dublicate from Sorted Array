class Solution {
    public int removeDuplicates(int[] nums) {
        // Edge case: An empty array has 0 unique elements
        if (nums.length == 0) return 0;
   
        int i = 0;
        
        for (int j = 1; j < nums.length; j++) {
            // If we find a new unique element
            if (nums[j] != nums[i]) {
                i++;            
                nums[i] = nums[j]; 
            }
        }
        
   
        return i + 1;
    }
}
